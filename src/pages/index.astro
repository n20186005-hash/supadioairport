---
import BaseLayout from '../layouts/BaseLayout.astro';
import { airport, officialSources } from '../data/site';

const pageUrl = Astro.site ? new URL('/', Astro.site).href : undefined;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['TouristAttraction', 'LocalBusiness'],
      additionalType: 'https://schema.org/Airport',
      name: airport.name,
      alternateName: `${airport.shortName} (${airport.iata})`,
      description: 'Bandara utama yang melayani Pontianak dan gerbang udara Kalimantan Barat di Kabupaten Kubu Raya.',
      ...(pageUrl ? { url: pageUrl } : {}),
      image: pageUrl ? new URL('/images/supadio-aircraft.webp', pageUrl).href : '/images/supadio-aircraft.webp',
      address: { '@type': 'PostalAddress', streetAddress: 'Jl. Arteri Supadio Km. 17', addressLocality: 'Sungai Raya', addressRegion: 'Kalimantan Barat', postalCode: '78391', addressCountry: 'ID' },
      geo: { '@type': 'GeoCoordinates', latitude: airport.latitude, longitude: airport.longitude },
      openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'], opens: '06:00', closes: '20:00' }],
      aggregateRating: { '@type': 'AggregateRating', ratingValue: airport.rating, bestRating: 5, ratingCount: airport.ratingCount }
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        ['Apakah Bandara Supadio buka 24 jam?', 'Akun resmi bandara mencantumkan jam operasi 06.00–20.00 WIB. Operasi penerbangan dapat berubah; periksa jadwal maskapai dan kanal resmi sebelum perjalanan.'],
        ['Apakah ada tiket masuk untuk mengunjungi terminal?', 'Tidak ada tiket wisata untuk masuk ke area publik terminal. Akses ke area terbatas mengikuti pemeriksaan keamanan dan ketentuan penerbangan. Biaya tiket pesawat, parkir, transportasi, atau layanan pilihan terpisah.'],
        ['Bagaimana menuju Bandara Supadio dari Pontianak?', 'Akses darat utama melewati koridor Jalan Ahmad Yani dan Jalan Arteri Supadio. Pilihan praktis mencakup taksi, kendaraan sewa, layanan transportasi berbasis aplikasi, kendaraan pribadi, serta layanan bus atau layanan antar-jemput yang perlu dikonfirmasi jadwalnya pada hari perjalanan.'],
        ['Apakah tersedia toilet dan tempat makan?', 'Profil resmi bandara mencantumkan fasilitas umum dan transportasi. Di terminal tersedia fasilitas penumpang dasar; lokasi, jam buka, dan layanan gerai dapat berubah sehingga ikuti papan petunjuk di lokasi.'],
        ['Apakah tersedia parkir?', 'Tersedia area parkir bandara untuk kendaraan. Tarif, zona, dan ketentuan dapat berubah; gunakan papan tarif dan petunjuk resmi di area parkir sebagai rujukan utama.'],
        ['Berapa lama sebaiknya berada di bandara?', 'Untuk penerbangan, ikuti batas waktu lapor masuk dari maskapai dan tambahkan waktu untuk lalu lintas, parkir, pemeriksaan keamanan, dan antrean. Untuk orientasi area publik tanpa penerbangan, sekitar 45–90 menit biasanya cukup.'],
        ['Apakah transportasi umum selalu tersedia?', 'Ketersediaan bus atau layanan antar-jemput dapat berubah menurut operator dan waktu. Situs ini tidak menampilkan jadwal tetap yang belum terverifikasi; konfirmasikan layanan pada hari perjalanan.'],
        ['Di mana letak Bandara Supadio?', 'Bandara berada di Limbung, Kecamatan Sungai Raya, Kabupaten Kubu Raya, Kalimantan Barat, di koridor utama menuju Pontianak.'],
        ['Apa kode bandara Supadio?', `Kode IATA bandara adalah ${airport.iata} dan kode ICAO adalah ${airport.icao}. Gunakan ${airport.iata} saat mencari atau memesan penerbangan, serta ${airport.icao} untuk rujukan penerbangan dan teknis.`]
      ].map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } }))
    }
  ]
};
---
<BaseLayout locale="id" pageKey="home" title="Bandara Supadio (PNK) Pontianak — Panduan Wisata | Penerbangan, Fasilitas & Transportasi" description="Panduan lengkap Bandara Udara Supadio (PNK) Pontianak: jam operasi 06.00–20.00 WIB, transportasi dari kota, fasilitas terminal, parkir, dan sekitar Kubu Raya, Kalimantan Barat.">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main>
    <section class="relative min-h-[92vh] overflow-hidden bg-night text-white">
      <img src="/images/supadio-aircraft.webp" alt="Pesawat dan terminal Bandara Internasional Supadio" class="absolute inset-0 h-full w-full object-cover" fetchpriority="high" />
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(7,26,34,.93)_0%,rgba(7,26,34,.74)_45%,rgba(7,26,34,.2)_100%)]"></div>
      <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-night to-transparent"></div>
      <div class="container-site relative z-10 flex min-h-[92vh] items-end pb-16 pt-36 md:pb-24">
        <div class="max-w-3xl">
          <div class="mb-5 flex flex-wrap gap-2 text-xs font-extrabold tracking-[.16em]">
            <span class="rounded-full border border-runway/60 bg-night/50 px-4 py-2">PNK · {airport.icao}</span>
            <span class="rounded-full border border-white/20 bg-night/50 px-4 py-2">KUBU RAYA · KALIMANTAN BARAT</span>
          </div>
          <p class="eyebrow mb-4 text-runway">Gerbang udara menuju Pontianak</p>
          <h1 class="max-w-3xl text-5xl font-black leading-[.95] tracking-[-.045em] md:text-7xl">Kenali Supadio sebelum perjalanan dimulai.</h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-white/80">Panduan pengunjung independen untuk memahami bandara, akses darat, fasilitas, sejarah, dan konteks wilayah—tanpa promosi komersial.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#transportasi" class="focus-ring rounded-full bg-runway px-6 py-3 font-extrabold text-night">Rencanakan akses</a>
            <a href="#peta" class="focus-ring rounded-full border border-white/30 bg-white/5 px-6 py-3 font-bold backdrop-blur">Lihat peta</a>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-night pb-12 text-white">
      <div class="container-site grid gap-px overflow-hidden rounded-3xl border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-4">
        {[
          ['Lokasi', 'Limbung · Sungai Raya'],
          ['Jam operasi', airport.operatingHours + '*'],
          ['Kode bandara', airport.iata + ' / ' + airport.icao],
          ['Ulasan Google Maps', `${airport.rating}/5 · sekitar ${airport.ratingCount.toLocaleString('id-ID')} ulasan*`]
        ].map(([k,v]) => <div class="bg-night/95 p-6"><p class="text-xs font-bold uppercase tracking-[.16em] text-white/45">{k}</p><p class="mt-2 text-xl font-extrabold">{v}</p></div>)}
      </div>
      <p class="container-site mt-3 text-xs text-white/45">*Jam operasi dan penilaian dapat berubah. Konfirmasikan informasi operasional melalui kanal resmi dan maskapai.</p>
    </section>

    <section id="kenali" class="section-pad">
      <div class="container-site grid gap-12 lg:grid-cols-[.85fr_1.15fr] lg:items-start">
        <div class="lg:sticky lg:top-8">
          <p class="eyebrow text-river">Kenali Supadio</p>
          <h2 class="mt-4 text-4xl font-black tracking-[-.04em] md:text-5xl">Lebih dari titik keberangkatan.</h2>
          <p class="mt-5 max-w-xl leading-8 text-ink/70">Bandara Supadio berada di Kabupaten Kubu Raya dan menjadi simpul udara penting bagi Pontianak serta perjalanan ke berbagai wilayah Kalimantan Barat.</p>
          <img src="/images/supadio-apron.jpg" alt="Apron dan terminal Bandara Supadio" class="mt-8 aspect-[4/3] w-full rounded-[2rem] object-cover shadow-xl" loading="lazy" />
        </div>
        <div class="space-y-5">
          <article class="card p-7 md:p-9"><p class="eyebrow text-runway">Identitas</p><h3 class="mt-2 text-2xl font-extrabold">PNK untuk penumpang, WIOO untuk penerbangan</h3><p class="mt-4 leading-8 text-ink/70">Direktorat Jenderal Perhubungan Udara mencatat Supadio sebagai bandar udara berstatus penggunaan internasional, dikelola PT Angkasa Pura Indonesia, berlokasi di Limbung, Sungai Raya, Kabupaten Kubu Raya.</p></article>
          <article class="card p-7 md:p-9"><p class="eyebrow text-runway">Jejak sejarah</p><h3 class="mt-2 text-2xl font-extrabold">Dari Sungai Durian menuju terminal modern</h3><p class="mt-4 leading-8 text-ink/70">Bandara ini dikenal dalam sejarahnya sebagai Bandar Udara Sungai Durian, lalu memakai nama Supadio. Terminal baru diresmikan pada 28 Desember 2017. Catatan Sekretariat Negara juga menyoroti penggunaan unsur ornamen Dayak pada wajah terminal—menempatkan identitas Kalimantan Barat langsung di gerbang kedatangannya.</p></article>
          <article class="card p-7 md:p-9"><p class="eyebrow text-runway">Pengalaman penumpang</p><h3 class="mt-2 text-2xl font-extrabold">Diakui dalam ASQ Awards</h3><p class="mt-4 leading-8 text-ink/70">ACI Asia-Pacific & Middle East mencantumkan Supadio sebagai pemenang kategori bandara terbaik dengan 2–5 juta penumpang di Asia-Pasifik pada Penghargaan ASQ 2024. Penghargaan ini berkaitan dengan pengalaman penumpang dan tidak mengubah sifat panduan ini sebagai situs independen.</p></article>
        </div>
      </div>
    </section>

    <section id="sejarah" class="section-pad bg-cloud">
      <div class="container-site">
        <div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr]">
          <div>
            <p class="eyebrow text-river">Arsip, cerita lokal & ilmu kebandarudaraan</p>
            <h2 class="mt-4 text-4xl font-black tracking-[-.04em] md:text-5xl">Membaca Supadio sebagai lapisan sejarah dan infrastruktur.</h2>
            <p class="mt-5 leading-8 text-ink/70">Kawasan ini bukan hanya terminal sipil. Riwayat Pangkalan Udara Supadio yang diterbitkan TNI Angkatan Udara menelusuri jejak Lapangan Terbang Sungai Durian, sementara data regulator menjelaskan perannya dalam jaringan penerbangan modern.</p>
          </div>
          <div class="grid gap-4 md:grid-cols-2">
            <article class="card p-7"><p class="eyebrow text-runway">Masa awal</p><h3 class="mt-3 text-xl font-extrabold">Dari rencana kolonial ke lapangan terbang</h3><p class="mt-3 text-sm leading-7 text-ink/70">Profil sejarah TNI AU mencatat pemerintah Belanda pernah merencanakan lapangan terbang di Sungai Durian. Pembangunannya kemudian dilanjutkan pada masa pendudukan Jepang dan kawasan ini berkembang menjadi simpul penerbangan strategis.</p></article>
            <article class="card p-7"><p class="eyebrow text-runway">Masa Indonesia</p><h3 class="mt-3 text-xl font-extrabold">Dibangun kembali dan berganti nama</h3><p class="mt-3 text-sm leading-7 text-ink/70">Usaha pembangunan kembali disebut mulai pada awal 1950-an. Dalam kronologi TNI AU, nama Pangkalan Udara Sungai Durian berubah menjadi Pangkalan TNI AU Supadio pada 1969.</p></article>
            <article class="card p-7"><p class="eyebrow text-runway">Terminal modern</p><h3 class="mt-3 text-xl font-extrabold">Identitas Kalimantan Barat di gerbang kedatangan</h3><p class="mt-3 text-sm leading-7 text-ink/70">Terminal baru diresmikan pada 28 Desember 2017. Arsip Sekretariat Negara menyebut unsur ornamen Dayak pada bangunan terminal sebagai bagian dari karakter arsitekturnya.</p></article>
            <article class="card p-7"><p class="eyebrow text-runway">Catatan cerita lokal</p><h3 class="mt-3 text-xl font-extrabold">Mengapa dahulu disebut Sungai Durian?</h3><p class="mt-3 text-sm leading-7 text-ink/70">Profil sejarah TNI AU merekam cerita lisan bahwa warga yang membuka tepian sungai menanam pohon durian hingga kampung dikenal sebagai Sungai Durian. Ini kami tampilkan sebagai tradisi tutur yang dicatat sumber resmi—bukan sebagai temuan arkeologis atau fakta yang berdiri sendiri.</p></article>
          </div>
        </div>
        <div class="mt-10 grid gap-px overflow-hidden rounded-[2rem] border border-ink/10 bg-ink/10 sm:grid-cols-2 lg:grid-cols-4">
          <div class="bg-night p-6 text-white"><p class="text-xs font-bold uppercase tracking-[.16em] text-white/45">Landas pacu</p><p class="mt-2 text-2xl font-black">2.600 × 45 m</p><p class="mt-2 text-xs leading-6 text-white/55">Dimensi terverifikasi yang ditampilkan Ditjen Hubud.</p></div>
          <div class="bg-night p-6 text-white"><p class="text-xs font-bold uppercase tracking-[.16em] text-white/45">Klasifikasi</p><p class="mt-2 text-2xl font-black">4C</p><p class="mt-2 text-xs leading-6 text-white/55">Kode klasifikasi bandar udara pada profil regulator.</p></div>
          <div class="bg-night p-6 text-white"><p class="text-xs font-bold uppercase tracking-[.16em] text-white/45">Pesawat acuan</p><p class="mt-2 text-2xl font-black">Boeing 737-800</p><p class="mt-2 text-xs leading-6 text-white/55">Dicantumkan sebagai pesawat acuan oleh regulator.</p></div>
          <div class="bg-night p-6 text-white"><p class="text-xs font-bold uppercase tracking-[.16em] text-white/45">Penggunaan</p><p class="mt-2 text-2xl font-black">Internasional</p><p class="mt-2 text-xs leading-6 text-white/55">Status penggunaan pada profil Ditjen Perhubungan Udara.</p></div>
        </div>
      </div>
    </section>

    <section class="section-pad bg-river text-white">
      <div class="container-site">
        <div class="max-w-3xl"><p class="eyebrow text-runway">Sebelum berangkat</p><h2 class="mt-4 text-4xl font-black tracking-[-.04em] md:text-5xl">Empat hal yang layak dicek ulang.</h2></div>
        <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          {[
            ['01','Jadwal penerbangan','Gunakan aplikasi atau kanal resmi maskapai. Jangan mengandalkan jadwal statis dari situs panduan.'],
            ['02','Waktu perjalanan darat','Tambahkan cadangan untuk lalu lintas koridor Pontianak–Sungai Raya, parkir, dan antrean.'],
            ['03','Dokumen perjalanan','Pastikan identitas, tiket, serta dokumen tambahan sesuai tujuan dan persyaratan maskapai.'],
            ['04','Titik penjemputan','Ikuti rambu resmi untuk taksi, kendaraan aplikasi, kendaraan pribadi, dan area penjemputan.']
          ].map(([n,t,d]) => <article class="rounded-3xl border border-white/12 bg-white/5 p-6"><p class="font-mono text-sm text-runway">{n}</p><h3 class="mt-5 text-xl font-extrabold">{t}</h3><p class="mt-3 text-sm leading-7 text-white/70">{d}</p></article>)}
        </div>
      </div>
    </section>

    <section id="transportasi" class="section-pad">
      <div class="container-site">
        <div class="grid gap-8 lg:grid-cols-[.65fr_1.35fr]">
          <div><p class="eyebrow text-river">Transportasi terperinci</p><h2 class="mt-4 text-4xl font-black tracking-[-.04em] md:text-5xl">Dari kota ke terminal, tanpa jadwal yang ditebak-tebak.</h2><p class="mt-5 leading-8 text-ink/70">Karena Supadio sendiri adalah bandar udara, bagian ini mencakup kedatangan dengan pesawat menuju kode PNK sekaligus akses darat dari Pontianak dan kawasan sekitarnya.</p></div>
          <div class="grid gap-4 md:grid-cols-2">
            {[
              ['Dengan pesawat menuju PNK','Gunakan kode IATA PNK saat mencari penerbangan. Setelah mendarat, Anda sudah berada di lokasi panduan ini; lanjutkan ke area kedatangan, pengambilan bagasi, lalu pilih moda darat dari zona resmi.'],
              ['Dari pusat Pontianak','Arah umum melalui koridor Jl. Ahmad Yani menuju Jl. Arteri Supadio. Perjalanan sering berada pada kisaran puluhan menit, tetapi kemacetan, hujan, dan jam sibuk dapat mengubahnya.'],
              ['Taksi','Pilihan langsung dari kota atau terminal. Gunakan zona resmi, pastikan tarif atau metode perhitungan sebelum berangkat, dan hindari penawaran yang tidak jelas.'],
              ['Transportasi berbasis aplikasi','Ketersediaan bergantung waktu dan aturan titik jemput. Ikuti petunjuk aplikasi serta rambu zona penjemputan bandara.'],
              ['Bus / layanan antar-jemput','Layanan dapat berubah menurut operator dan periode. Konfirmasikan rute, jam, titik naik, dan pembayaran pada hari perjalanan; situs ini sengaja tidak menampilkan jadwal tetap yang belum terverifikasi.'],
              ['Kendaraan pribadi','Masuk melalui koridor arteri bandara. Bedakan jalur antar penumpang dengan area parkir dan sediakan waktu untuk masuk/keluar kawasan terminal.'],
              ['Dari luar Pontianak','Perjalanan antarkota umumnya membutuhkan sambungan kendaraan darat menuju koridor Sungai Raya. Rencanakan perpindahan dan waktu cadangan secara terpisah.']
            ].map(([t,d]) => <article class="card p-7"><h3 class="text-xl font-extrabold">{t}</h3><p class="mt-3 text-sm leading-7 text-ink/70">{d}</p></article>)}
          </div>
        </div>
      </div>
    </section>

    <section id="fasilitas" class="section-pad bg-white/60">
      <div class="container-site">
        <p class="eyebrow text-river">Fasilitas & kebutuhan praktis</p>
        <h2 class="mt-4 max-w-4xl text-4xl font-black tracking-[-.04em] md:text-5xl">Informasi yang biasanya dicari setelah turun dari kendaraan.</h2>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {[
            ['WC & sanitasi','Cari simbol toilet di ruang publik terminal. Untuk kebutuhan aksesibilitas atau bantuan khusus, hubungi petugas bandara.'],
            ['Ibadah','Fasilitas ibadah umumnya tersedia di lingkungan terminal; ikuti papan petunjuk karena lokasi akses dapat berubah.'],
            ['Pengisian daya','Titik daya dapat tersedia di area tunggu. Bawa adaptor/kabel sendiri dan jangan meninggalkan perangkat tanpa pengawasan.'],
            ['ATM & pembayaran','Ketersediaan ATM atau sarana pembayaran dapat berubah menurut area terminal. Siapkan lebih dari satu metode pembayaran untuk kebutuhan perjalanan.'],
            ['Makan & minum','Di terminal dan koridor menuju kota tersedia layanan makanan. Panduan ini tidak mengunggulkan gerai atau merek tertentu.'],
            ['Minimarket / kebutuhan harian','Cari kategori toko kebutuhan harian di terminal atau sepanjang koridor arteri; cek jam buka pada saat kedatangan.'],
            ['Bagasi','Ikuti layar dan penanda pengambilan bagasi dan konter lapor masuk. Masalah bagasi sebaiknya langsung ditangani melalui maskapai atau petugas terkait.'],
            ['Sewa kendaraan','Jika membutuhkan kendaraan sewa, gunakan layanan berizin, pahami syarat sewa dan perlindungan asuransi, serta konfirmasikan lokasi serah-terima tanpa bergantung pada merek tertentu.'],
            ['Aksesibilitas','Penumpang yang memerlukan kursi roda atau bantuan khusus dianjurkan mengatur layanan dengan maskapai sebelum keberangkatan.'],
            ['Akomodasi','Pilihan tipe penginapan ada di koridor bandara dan pusat Pontianak. Pilih berdasarkan kebutuhan waktu transit, akses kota, dan anggaran—bukan rekomendasi merek.'],
            ['BBM & pengisian kendaraan listrik','SPBU tersedia di koridor jalan utama. Ketersediaan pengisi daya kendaraan listrik dapat berubah; periksa peta jaringan/operator sebelum mengandalkannya.']
          ].map(([t,d]) => <article class="rounded-3xl border border-ink/10 bg-cloud p-6"><h3 class="font-extrabold">{t}</h3><p class="mt-3 text-sm leading-7 text-ink/65">{d}</p></article>)}
        </div>
        <div class="mt-10 overflow-hidden rounded-[2rem] bg-night p-3"><img src="/images/supadio-interior.jpg" alt="Bagian dalam terminal Bandara Internasional Supadio" class="max-h-[560px] w-full rounded-[1.4rem] object-cover" loading="lazy" /><p class="px-3 pb-2 pt-3 text-xs text-white/55">Interior terminal. Foto: SunDawn, CC BY-SA 4.0, melalui Wikimedia Commons.</p></div>
      </div>
    </section>

    <section class="section-pad bg-river text-white">
      <div class="container-site">
        <div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr]">
          <div><p class="eyebrow text-runway">Alur penumpang</p><h2 class="mt-4 text-4xl font-black tracking-[-.04em] md:text-5xl">Pahami urutannya, lalu ikuti petunjuk di terminal.</h2><p class="mt-5 leading-8 text-white/70">Tata letak rinci dapat berubah, tetapi urutan fungsi bandara membantu pengunjung membaca ruang tanpa bergantung pada denah yang cepat usang.</p></div>
          <div class="grid gap-4 md:grid-cols-2">
            <article class="rounded-3xl border border-white/12 bg-white/5 p-7"><p class="eyebrow text-runway">Keberangkatan</p><ol class="mt-4 space-y-3 text-sm leading-7 text-white/75"><li><strong>1.</strong> Tiba di zona antar penumpang atau parkir.</li><li><strong>2.</strong> Lapor masuk dan serahkan bagasi bila diperlukan.</li><li><strong>3.</strong> Ikuti pemeriksaan keamanan.</li><li><strong>4.</strong> Pantau layar informasi dan menuju pintu keberangkatan.</li></ol></article>
            <article class="rounded-3xl border border-white/12 bg-white/5 p-7"><p class="eyebrow text-runway">Kedatangan</p><ol class="mt-4 space-y-3 text-sm leading-7 text-white/75"><li><strong>1.</strong> Ikuti arus penumpang menuju area kedatangan.</li><li><strong>2.</strong> Ambil bagasi bila ada.</li><li><strong>3.</strong> Tangani masalah bagasi melalui maskapai atau petugas terkait.</li><li><strong>4.</strong> Keluar ke ruang publik dan ikuti zona transportasi resmi.</li></ol></article>
            <article class="rounded-3xl border border-white/12 bg-white/5 p-7 md:col-span-2"><p class="eyebrow text-runway">Kesehatan, bantuan & aksesibilitas</p><p class="mt-4 text-sm leading-7 text-white/75">Profil Ditjen Perhubungan Udara mencantumkan fasilitas medis dan Kantor Kesehatan Pelabuhan di bandara. Untuk kursi roda, pendampingan, kondisi medis, atau kebutuhan khusus lain, sebaiknya koordinasikan sejak awal dengan maskapai dan mintalah bantuan petugas di terminal. Untuk keadaan mendesak, utamakan petugas dan layanan darurat setempat.</p></article>
          </div>
        </div>
      </div>
    </section>

    <section class="section-pad">
      <div class="container-site grid gap-6 lg:grid-cols-3">
        <article class="card p-8"><p class="eyebrow text-river">Tiket / biaya</p><h2 class="mt-3 text-2xl font-extrabold">Tidak ada tiket wisata</h2><p class="mt-4 leading-7 text-ink/70">Area publik terminal bukan objek wisata bertiket. Tiket penerbangan, parkir, transportasi darat, ruang tunggu berlayanan khusus, bagasi berlebih, dan layanan pilihan memiliki biaya masing-masing. Untuk nilai yang berubah, gunakan tarif resmi saat transaksi.</p></article>
        <article class="card p-8"><p class="eyebrow text-river">Parkir</p><h2 class="mt-3 text-2xl font-extrabold">Ikuti zona & papan tarif</h2><p class="mt-4 leading-7 text-ink/70">Area parkir tersedia di kawasan bandara. Bedakan zona antar penumpang, penjemputan, parkir mobil, dan parkir sepeda motor. Tarif dan aturan dapat diperbarui; papan resmi di pintu masuk menjadi rujukan utama.</p></article>
        <article class="card p-8"><p class="eyebrow text-river">Waktu & durasi</p><h2 class="mt-3 text-2xl font-extrabold">Rencanakan berdasarkan penerbangan</h2><p class="mt-4 leading-7 text-ink/70">Untuk terbang, patuhi batas lapor masuk maskapai dan tambahkan waktu cadangan perjalanan. Jika hanya mengantar, menjemput, atau mengenali area publik, sekitar 45–90 menit biasanya memadai. Pagi dapat terasa lebih nyaman untuk perjalanan darat, namun cuaca tropis dapat berubah cepat.</p></article>
      </div>
    </section>

    <section id="sekitar" class="section-pad bg-night text-white">
      <div class="container-site">
        <div class="grid gap-10 lg:grid-cols-[.7fr_1.3fr]">
          <div><p class="eyebrow text-runway">Sekitar bandara</p><h2 class="mt-4 text-4xl font-black tracking-[-.04em] md:text-5xl">Dari koridor Kubu Raya menuju Pontianak.</h2><p class="mt-5 leading-8 text-white/65">Pilihan di bawah bersifat kategori layanan atau tempat budaya publik. Kami tidak menyusun peringkat restoran, hotel, toko, atau penyedia transportasi.</p></div>
          <div class="space-y-4">
            <article class="rounded-3xl border border-white/12 p-7"><h3 class="text-xl font-extrabold text-runway">Makanan di sekitar</h3><p class="mt-3 leading-7 text-white/65">Sepanjang Arteri Supadio dan arah Ahmad Yani terdapat tipe layanan seperti rumah makan lokal, warung, kedai kopi, toko roti, minimarket, dan tempat makan keluarga. Pilih berdasarkan kebersihan, harga yang jelas, kebutuhan diet, dan jam operasional.</p></article>
            <article class="rounded-3xl border border-white/12 p-7"><h3 class="text-xl font-extrabold text-runway">Belanja, penginapan & kendaraan</h3><p class="mt-3 leading-7 text-white/65">Untuk kebutuhan perjalanan, cari kategori supermarket/minimarket, hotel atau penginapan transit, apotek, SPBU, bengkel, dan—bila diperlukan—titik pengisian kendaraan listrik. Verifikasi ketersediaan aktual sebelum berangkat.</p></article>
          </div>
        </div>
        <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          {[
            ['Tugu Khatulistiwa','Penanda kawasan yang memperkenalkan posisi Pontianak di garis khatulistiwa.'],
            ['Museum Kalimantan Barat','Ruang pengenalan sejarah, budaya, dan koleksi daerah Kalimantan Barat.'],
            ['Rumah Radakng','Bangunan budaya yang merepresentasikan tradisi rumah panjang Dayak.'],
            ['Taman Alun Kapuas','Ruang publik tepi Sungai Kapuas di pusat Pontianak.']
          ].map(([t,d]) => <article class="rounded-3xl bg-white/6 p-6"><p class="eyebrow text-white/40">Tempat publik</p><h3 class="mt-3 text-lg font-extrabold">{t}</h3><p class="mt-3 text-sm leading-7 text-white/60">{d}</p><p class="mt-4 text-xs font-bold text-runway">Perhitungkan 30–60+ menit menuju area kota, bergantung lalu lintas.</p></article>)}
        </div>
      </div>
    </section>

    <section id="peta" class="section-pad">
      <div class="container-site grid gap-8 lg:grid-cols-[.65fr_1.35fr] lg:items-center">
        <div><p class="eyebrow text-river">Peta lokasi</p><h2 class="mt-4 text-4xl font-black tracking-[-.04em]">Jl. Arteri Supadio Km. 17</h2><p class="mt-5 leading-8 text-ink/70">Limbung, Kecamatan Sungai Raya, Kabupaten Kubu Raya, Kalimantan Barat. Peta Google di bawah menggunakan bahasa dan wilayah Indonesia.</p><p class="mt-4 text-sm font-bold">Koordinat panduan: {airport.latitude}, {airport.longitude}</p></div>
        <div class="overflow-hidden rounded-[2rem] border border-ink/10 bg-white p-2 shadow-xl">
          <iframe title="Peta Bandara Internasional Supadio" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6899.037952232692!2d109.40270841243542!3d-0.1476037998503186!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e1d59b7211fe5cf%3A0xbe952b257ebaed28!2z6IuP5be06L-q5aWl5Zu96ZmF5py65Zy6!5e1!3m2!1sid!2sid!4v1787144371325!5m2!1sid!2sid" width="100%" height="520" style="border:0;" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
      </div>
    </section>

    <section id="faq" class="section-pad bg-white/60">
      <div class="container-site grid gap-10 lg:grid-cols-[.65fr_1.35fr]">
        <div><p class="eyebrow text-river">Tanya jawab</p><h2 class="mt-4 text-4xl font-black tracking-[-.04em]">Pertanyaan yang paling berguna sebelum datang.</h2></div>
        <div class="space-y-3">
          {[
            ['Apakah Bandara Supadio buka 24 jam?','Akun resmi bandara mencantumkan jam operasi 06.00–20.00 WIB. Operasi penerbangan dapat berubah; periksa jadwal maskapai dan kanal resmi sebelum perjalanan.'],
            ['Apakah ada tiket masuk ke terminal?','Tidak ada tiket wisata untuk area publik. Area terbatas mengikuti pemeriksaan keamanan dan ketentuan penerbangan; layanan seperti parkir atau transportasi berbayar terpisah.'],
            ['Apa cara paling sederhana dari Pontianak?','Taksi, kendaraan berbasis aplikasi, kendaraan pribadi, atau layanan antar-jemput atau bus yang tersedia. Untuk angkutan umum, konfirmasi jadwal aktual pada hari perjalanan.'],
            ['Apakah ada WC, makanan, dan pengisian daya?','Fasilitas penumpang dasar tersedia di lingkungan terminal, tetapi titik dan jam layanan dapat berubah. Ikuti papan petunjuk dan tanyakan petugas jika membutuhkan akses tertentu.'],
            ['Apakah tersedia parkir?','Ya, terdapat area parkir kawasan bandara. Gunakan zona resmi dan lihat papan tarif terbaru di lokasi.'],
            ['Kapan sebaiknya tiba?','Ikuti ketentuan lapor masuk maskapai lalu tambahkan waktu untuk perjalanan darat, parkir, pemeriksaan keamanan, serta potensi antrean.'],
            ['Apakah situs ini menjual tiket atau menerima komisi?','Tidak. Panduan Supadio adalah proyek informasi nirlaba dan tidak menjual tiket, menerima pemesanan, atau membuat peringkat komersial.'],
            ['Bagaimana jika data di sini berbeda dengan papan bandara?','Utamakan informasi operasional dari bandara, maskapai, petugas, dan regulator. Informasi yang mudah berubah di situs ini selalu dimaksudkan sebagai panduan awal.'],
            ['Apa kode bandara Supadio?', `Kode IATA adalah ${airport.iata} (PNK) dan kode ICAO adalah ${airport.icao} (WIOO). Gunakan PNK saat mencari atau memesan penerbangan.`]
          ].map(([q,a]) => <details class="group rounded-2xl border border-ink/10 bg-cloud p-5"><summary class="cursor-pointer list-none pr-8 font-extrabold">{q}</summary><p class="mt-4 max-w-3xl text-sm leading-7 text-ink/68">{a}</p></details>)}
