---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { airport } from '../data/site';

interface Props { title: string; description: string; image?: string; hideHeader?: boolean; }
const { title, description, image = '/images/supadio-aircraft.webp', hideHeader = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const absoluteImage = Astro.site ? new URL(image, Astro.site).href : image;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#071a22" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImage} />
    {canonical && <meta property="og:url" content={canonical} />}
  </head>
  <body>
    {!hideHeader && <Header />}
    <slot />
    <Footer />
    <div id="cookie-banner" class="fixed inset-x-4 bottom-4 z-50 mx-auto hidden max-w-3xl rounded-2xl border border-white/10 bg-night p-5 text-white shadow-2xl" role="region" aria-label="Persetujuan cookie">
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <p class="text-sm leading-6 text-white/80">Kami memakai cookie yang diperlukan agar situs berfungsi. Google Analytics hanya dimuat setelah Anda menyetujui cookie analitik.</p>
        <div class="flex shrink-0 flex-wrap gap-2">
          <button data-cookie-reject class="rounded-full border border-white/25 px-4 py-2 text-sm font-bold hover:bg-white/10">Tolak analitik</button>
          <button data-cookie-accept class="rounded-full bg-runway px-4 py-2 text-sm font-bold text-night hover:brightness-110">Izinkan analitik</button>
          <a class="rounded-full px-3 py-2 text-sm font-bold underline" href="/pengaturan-cookie/">Atur</a>
        </div>
      </div>
    </div>
    <script define:vars={{ gaId: airport.gaId }}>window.SUPADIO_GA_ID = gaId;</script>
    <script src="/js/consent.js" defer></script>
  </body>
</html>
