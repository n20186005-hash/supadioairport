---
import { getAlternateLocale, getLocalizedPath, shellCopy, type Locale, type PageKey } from '../data/i18n';
interface Props { locale?: Locale; pageKey?: PageKey; }
const { locale = 'id', pageKey = 'home' } = Astro.props;
const copy = shellCopy[locale].header;
const homePath = getLocalizedPath('home', locale);
const targetLocale = getAlternateLocale(locale);
---
<header class="airport-header bg-night text-white"><div class="container-site airport-nav"><a class="airport-brand" href={homePath} aria-label={copy.homeLabel}><img src="/icons/logo.svg" width="205" height="50" alt="Supadio Guide · Panduan Supadio" /></a><a class="language-switch" href={getLocalizedPath(pageKey,targetLocale)} aria-label={copy.switchAria}>{copy.switchLabel}</a><nav aria-label={copy.ariaLabel}>{copy.links.map(link => <a href={link.id === 'topik' ? getLocalizedPath('topics', locale) : `${homePath}#${link.id}`}>{link.label}</a>)}<a href={`${homePath}#peta`}>{locale === 'en' ? 'Map' : 'Peta'}</a></nav></div></header>
