---
import BaseLayout from '../layouts/BaseLayout.astro';
import { airport, officialSources } from '../data/site';
import { guideCopy } from '../data/guide';
import type { Locale } from '../data/i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = guideCopy[locale];
const en = locale === 'en';
const mapLink = 'https://maps.app.goo.gl/tPiTuQvcWjzH4WDTA';
const pageUrl = new URL(en ? '/en/' : '/', Astro.site).href;
const graph = { '@context':'https://schema.org', '@graph': [
 { '@type':'Airport', '@id':'https://supadioairport.com/#airport', name:'Supadio Airport', iataCode:'PNK', icaoCode:'WIOO', description: en ? 'Airport in Limbung, Sungai Raya, Kubu Raya, West Kalimantan.' : 'Bandara di Limbung, Sungai Raya, Kubu Raya, Kalimantan Barat.', address:{'@type':'PostalAddress',addressLocality:'Limbung, Sungai Raya, Kubu Raya',addressRegion:'Kalimantan Barat',addressCountry:'ID'},geo:{'@type':'GeoCoordinates',latitude:airport.latitude,longitude:airport.longitude},hasMap:mapLink },
 { '@type':'WebPage', url:pageUrl, name:c.title, inLanguage:locale, about:{'@id':'https://supadioairport.com/#airport'} },
 { '@type':'FAQPage',mainEntity:c.faq.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}})) }
]};
---
<BaseLayout locale={locale} pageKey="home" title={c.title} description={c.description}>
<main id="konten"><section class="relative overflow-hidden bg-night text-white"><img src="/images/supadio-aircraft.webp" width="1200" height="800" alt={c.photo} fetchpriority="high" class="absolute inset-0 h-full w-full object-cover" /><div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(7,26,34,.94),rgba(7,26,34,.64))]"></div><div class="container-site relative py-24 lg:py-32"><div class="max-w-3xl"><p class="eyebrow text-runway">{c.eyebrow}</p><h1 class="mt-6 text-5xl font-black leading-tight tracking-[-.04em] md:text-7xl">{c.h1}</h1><p class="mt-6 text-lg leading-8 text-white/85">{c.intro}</p><div class="mt-8 flex flex-wrap gap-3"><a href="#penerbangan" class="rounded-full bg-runway px-6 py-3 font-bold text-night">{c.cta}</a><a href="#peta" class="rounded-full border border-white/40 px-6 py-3 font-bold">{c.map}</a></div></div></div></section>
<p class="photo-note container-site"><a href="https://commons.wikimedia.org/wiki/File:Bandara-Supadio-Pontianak.webp">{c.heroCredit}</a></p>
<section class="bg-night pb-8 text-white"><div class="container-site grid gap-3 sm:grid-cols-2 lg:grid-cols-4">{c.stats.map(([label,value])=><div class="rounded-2xl border border-white/15 p-5"><p class="text-xs uppercase tracking-widest text-white/60">{label}</p><p class="mt-2 font-bold leading-7">{value}</p></div>)}</div></section>
<section id="kenali" class="section-pad"><div class="container-site grid gap-10 lg:grid-cols-2"><div><p class="eyebrow text-river">PNK · WIOO</p><h2 class="mt-4 text-3xl font-black md:text-4xl">{c.overviewTitle}</h2><p class="mt-6 leading-8 text-ink/75">{c.overview}</p><a class="mt-5 inline-block font-bold underline" href="https://hubud.kemenhub.go.id/bandara/123">{c.official}</a></div><article class="card p-7"><h2 class="text-2xl font-extrabold">{c.hoursTitle}</h2><p class="mt-5 leading-8 text-ink/75">{c.hours}</p></article></div></section>
<section class="section-pad bg-white/60"><div class="container-site grid gap-10 lg:grid-cols-2"><div><h2 class="text-3xl font-black">{c.historyTitle}</h2><p class="mt-6 leading-8 text-ink/75">{c.history}</p><a class="mt-5 inline-block font-bold underline" href={officialSources[1].href}>{c.historyLink}</a></div><figure class="overflow-hidden rounded-3xl"><img src="/images/supadio-apron.jpg" alt={c.apronAlt} width="2048" height="1070" loading="lazy" class="w-full" /><figcaption class="photo-note"><a href="https://commons.wikimedia.org/wiki/File:Supadio_Airport_terminal.jpg">{c.apronCredit}</a></figcaption></figure></div></section>
<section id="penerbangan" class="section-pad bg-river text-white"><div class="container-site"><h2 class="max-w-4xl text-3xl font-black md:text-4xl">{c.flightTitle}</h2><div class="mt-10 grid gap-5 lg:grid-cols-3">{c.flightCards.map(([h,p])=><article class="rounded-3xl border border-white/20 p-7"><h3 class="text-xl font-extrabold">{h}</h3><p class="mt-4 leading-8 text-white/80">{p}</p></article>)}</div></div></section>
<section id="transportasi" class="section-pad"><div class="container-site"><h2 class="max-w-4xl text-3xl font-black md:text-4xl">{c.transportTitle}</h2><div class="mt-10 grid gap-5 lg:grid-cols-3">{c.transportCards.map(([h,p])=><article class="card p-7"><h3 class="text-xl font-extrabold">{h}</h3><p class="mt-4 leading-8 text-ink/75">{p}</p></article>)}</div></div></section>
<section id="fasilitas" class="section-pad bg-white/60"><div class="container-site"><h2 class="max-w-4xl text-3xl font-black md:text-4xl">{c.facilitiesTitle}</h2><p class="mt-6 max-w-4xl leading-8 text-ink/75">{c.facilities}</p><figure class="mt-10 overflow-hidden rounded-3xl"><img src="/images/supadio-interior.webp" alt={c.interiorAlt} loading="lazy" width="1600" height="1200" class="max-h-[560px] w-full object-cover" /><figcaption class="photo-note"><a href="https://commons.wikimedia.org/wiki/File:Supadio_International_Airport_Terminal_Interior.jpg">{c.interiorCredit}</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a></figcaption></figure></div></section>
<section id="sekitar" class="section-pad"><div class="container-site max-w-4xl"><h2 class="text-3xl font-black">{c.nearbyTitle}</h2><p class="mt-6 leading-8 text-ink/75">{c.nearby}</p></div></section>
<section id="peta" class="section-pad bg-night text-white"><div class="container-site grid gap-10 lg:grid-cols-2"><div><h2 class="text-3xl font-black">{c.locationTitle}</h2><p class="mt-6 leading-8 text-white/80">{c.location}</p><a class="mt-6 inline-flex rounded-full bg-runway px-6 py-3 font-bold text-night" href={mapLink} target="_blank" rel="noreferrer">Google Maps ↗</a></div><iframe title={en ? 'Supadio Airport visitor-location map' : 'Peta orientasi pengunjung Bandara Supadio'} src="https://maps.google.com/maps?q=-0.1476038,109.4052887&amp;z=15&amp;output=embed" width="600" height="500" style="border:0;width:100%" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></section>
<section id="faq" class="section-pad"><div class="container-site grid gap-10 lg:grid-cols-[.6fr_1.4fr]"><h2 class="text-3xl font-black md:text-4xl">{c.faqTitle}</h2><div class="space-y-4">{c.faq.map(([q,a])=><details class="card p-6"><summary class="cursor-pointer font-extrabold">{q}</summary><p class="mt-4 leading-8 text-ink/75">{a}</p></details>)}</div></div></section>
<section id="sumber" class="section-pad bg-white/60"><div class="container-site"><h2 class="text-3xl font-black">{c.sourceTitle}</h2><p class="mt-6 max-w-4xl leading-8">{c.sourceNote}</p><ul class="mt-6 space-y-4">{officialSources.map(source=><li><a class="font-bold underline" href={source.href}>{source.label}</a></li>)}<li><a class="font-bold underline" href={mapLink}>Google Maps · {en ? 'checked 19 October 2026' : 'diperiksa 19 Oktober 2026'}</a></li></ul></div></section>
</main><script is:inline type="application/ld+json" set:html={JSON.stringify(graph)}></script></BaseLayout>
