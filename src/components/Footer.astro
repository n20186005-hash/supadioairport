---
import { getLocalizedPath, shellCopy, type Locale, type PageKey } from '../data/i18n';
interface Props { locale?: Locale; pageKey?: PageKey; }
const { locale = 'id' } = Astro.props;
const copy = shellCopy[locale].footer;
---
<footer class="bg-night text-white"><div class="container-site grid gap-8 py-12 lg:grid-cols-[1.2fr_.8fr]"><div><p class="text-xl font-extrabold">{locale === 'en' ? 'Supadio independent guide' : 'Panduan Supadio independen'}</p><p class="mt-4 max-w-3xl leading-8 text-white/75">{locale === 'en' ? 'Independent visitor information with no affiliation to the airport operator, airlines or government. No flight-status feed, ticket sales, bookings, account or contact form is provided.' : 'Informasi pengunjung independen tanpa afiliasi dengan pengelola bandara, maskapai atau pemerintah. Tidak menyediakan data status penerbangan, penjualan tiket, pemesanan, akun atau formulir kontak.'}</p><p class="mt-4 text-sm text-white/65">{locale === 'en' ? 'Sources checked 19 October 2026. Photo rights follow the individual source licences.' : 'Sumber diperiksa 19 Oktober 2026. Hak foto mengikuti lisensi sumber masing-masing.'}</p></div><nav aria-label={copy.siteInfoTitle} class="grid gap-2">{copy.siteInfoLinks.map(link => <a href={getLocalizedPath(link.pageKey,locale)}>{link.label}</a>)}<a href={`${getLocalizedPath('home',locale)}#sumber`}>{copy.sourcesLabel}</a></nav></div></footer>
